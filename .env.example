# Private Nitro SDK configuration
NUXT_UNLEASH_URL=https://unleash.shapeandflow.de/api/
NUXT_UNLEASH_BACKEND_TOKEN=backend_development_replace_me
NUXT_UNLEASH_ENVIRONMENT=development
NUXT_UNLEASH_DEPLOYMENT=dev

# Public browser SDK configuration (frontend tokens are intentionally browser-readable)
NUXT_PUBLIC_UNLEASH_URL=https://unleash.shapeandflow.de/api/frontend
NUXT_PUBLIC_UNLEASH_FRONTEND_TOKEN=frontend_development_replace_me
NUXT_PUBLIC_UNLEASH_ENVIRONMENT=development
NUXT_PUBLIC_UNLEASH_DEPLOYMENT=dev
